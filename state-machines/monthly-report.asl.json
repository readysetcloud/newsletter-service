{
  "Comment": "Generate and send a monthly performance report for a single tenant",
  "StartAt": "Build Report Data",
  "States": {
    "Build Report Data": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${BuildMonthlyReportData}",
        "Payload": {
          "tenant.$": "$.tenant",
          "month.$": "$.month",
          "monthLabel.$": "$.monthLabel",
          "periodStart.$": "$.periodStart",
          "periodEnd.$": "$.periodEnd",
          "reportId.$": "$.reportId",
          "reportType.$": "$.reportType",
          "deliverEmail.$": "$.deliverEmail",
          "periodLabel.$": "$.periodLabel"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Has Issues?",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Mark Report Failed"
        }
      ]
    },
    "Has Issues?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.hasIssues",
          "BooleanEquals": true,
          "Next": "Generate Insights"
        },
        {
          "Variable": "$.reportType",
          "StringEquals": "adhoc",
          "Next": "Record Empty Range"
        }
      ],
      "Default": "No Issues This Month"
    },
    "No Issues This Month": {
      "Type": "Succeed"
    },
    "Generate Insights": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Parameters": {
        "FunctionName": "${GenerateMonthlyInsights}",
        "Payload": {
          "reportData.$": "$.reportData",
          "month.$": "$.month",
          "monthLabel.$": "$.monthLabel",
          "tenantId.$": "$.tenant.id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.insights",
      "Next": "Compile And Send Report",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Mark Report Failed"
        }
      ]
    },
    "Compile And Send Report": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${CompileMonthlyReport}",
        "Payload": {
          "tenant.$": "$.tenant",
          "month.$": "$.month",
          "monthLabel.$": "$.monthLabel",
          "periodStart.$": "$.periodStart",
          "periodEnd.$": "$.periodEnd",
          "reportData.$": "$.reportData",
          "insights.$": "$.insights.Payload.insights",
          "reportId.$": "$.reportId",
          "reportType.$": "$.reportType",
          "deliverEmail.$": "$.deliverEmail",
          "periodLabel.$": "$.periodLabel"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "End": true,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Mark Report Failed"
        }
      ]
    },
    "Record Empty Range": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Parameters": {
        "FunctionName": "${FinalizeReport}",
        "Payload": {
          "tenant.$": "$.tenant",
          "reportId.$": "$.reportId",
          "reportType.$": "$.reportType",
          "periodStart.$": "$.periodStart",
          "periodEnd.$": "$.periodEnd",
          "periodLabel.$": "$.periodLabel",
          "outcome": "empty"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "Mark Report Failed": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Parameters": {
        "FunctionName": "${FinalizeReport}",
        "Payload": {
          "tenant.$": "$.tenant",
          "reportId.$": "$.reportId",
          "reportType.$": "$.reportType",
          "periodStart.$": "$.periodStart",
          "periodEnd.$": "$.periodEnd",
          "periodLabel.$": "$.periodLabel",
          "outcome": "failed",
          "error.$": "$.error"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Report Failed"
    },
    "Report Failed": {
      "Type": "Fail",
      "Error": "ReportGenerationFailed",
      "Cause": "The report could not be generated; the stored report records why."
    }
  }
}
